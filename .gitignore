# ==========================================
# Externe Abhängigkeiten und Toolchains
# ==========================================
# Ignoriert den kompletten external/ Ordner (Pico-SDK, Toolchain, OpenOCD etc.)
external/
# Ignoriert heruntergeladene Archive (wie deine riscv32-embecosm-ubuntu...tar.gz)
*.tar.gz
*.tar.xz
*.zip
*.7z

# ==========================================
# Build-Ordner und CMake-Dateien
# ==========================================
# Ignoriert alle build/ Verzeichnisse, egal wie tief sie verschachtelt sind
build/
*/build/
*/*/build/
CMakeCache.txt
CMakeFiles/
Makefile
cmake_install.cmake
compile_commands.json
.ninja*

# ==========================================
# Kompilierte Binaries und Objektdateien
# ==========================================
# Falls doch mal etwas außerhalb eines build-Ordners landet
*.o
*.elf
*.bin
*.hex
*.uf2
*.map
*.dis
*.a

# ==========================================
# IDEs und Editor-Dateien
# ==========================================
# Ignoriert deine lokalen VS Code Einstellungen
.vscode/
.idea/
*.swp

# ==========================================
# OS-spezifische Dateien
# ==========================================
.DS_Store
Thumbs.db